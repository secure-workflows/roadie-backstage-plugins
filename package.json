{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "18 || 20 || 22"
  },
  "scripts": {
    "dev": "concurrently \"yarn start\" \"yarn start-backend\"",
    "dev:ci": "concurrently \"http-server packages/app/dist -a localhost --port 3000 --gzip --proxy http://localhost:3000?\" \"yarn start-backend\"",
    "start": "yarn workspace app start",
    "start-backend": "yarn workspace backend start",
    "start-backend:ci": "yarn workspace backend backstage-cli package build && node packages/backend",
    "start:ci": "concurrently \"yarn start\" \"yarn start-backend:ci\"",
    "build": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli clean",
    "test": "backstage-cli repo test --workerIdleMemoryLimit=800M --coverage --runInBand",
    "lint": "backstage-cli repo lint --since origin/main",
    "create-plugin": "backstage-cli create-plugin --scope roadiehq --no-private",
    "new": "backstage-cli new --scope roadiehq --no-private",
    "remove-plugin": "backstage-cli remove-plugin",
    "release": "changeset version && yarn prettier --write '{packages,plugins}/*/{package.json,CHANGELOG.md}' && yarn install --no-immutable",
    "prepare": "husky install"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "handlebars": "4.7.9",
    "jsonata": "2.2.1",
    "protobufjs": "7.6.1",
    "tar": "7.5.21",
    "@grpc/grpc-js": "1.13.5",
    "@isaacs/brace-expansion": "5.0.1",
    "@langchain/core": "1.1.8",
    "@remix-run/router": "1.23.2",
    "@xmldom/xmldom": "0.8.13",
    "basic-ftp": "5.3.1",
    "dset": "3.1.4",
    "fast-uri": "3.1.6",
    "flatted": "3.4.2",
    "glob": "10.5.0",
    "immutable": "3.8.4",
    "jsonpath": "1.3.0",
    "jsonpath-plus": "10.3.0",
    "jws": "4.0.1",
    "koa": "2.16.4",
    "launch-editor": "2.9.0",
    "linkify-it": "5.0.2",
    "lodash": "4.18.0",
    "lodash-es": "4.18.0",
    "multer": "2.2.0",
    "mysql2": "3.22.0",
    "nanoid": "3.3.18",
    "node-forge": "1.4.0",
    "playwright": "1.55.1",
    "postcss": "8.5.18",
    "rollup": "4.59.0",
    "tmp": "0.2.6",
    "underscore": "1.13.8",
    "undici": "7.29.0",
    "ws": "8.21.0"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "plugins/**",
      "utils/**"
    ]
  },
  "devDependencies": {
    "@backstage/cli": "backstage:^",
    "@changesets/cli": "^2.14.0",
    "concurrently": "^7.0.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-notice": "^1.0.0",
    "http-server": "^14.1.1",
    "husky": "^8.0.1",
    "lint-staged": "^15.0.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "^5.5.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "prettier": "@backstage/cli/config/prettier",
  "packageManager": "yarn@4.9.2"
}
